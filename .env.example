# Configuration NON SECRÈTE (le mot de passe DB est dans secrets/db_password.txt)
# Préfixe des images : local par défaut, ou ghcr.io/<utilisateur>/docker-eval pour le registry
IMAGE_PREFIX=docker-eval
# Version des images en mode prod (voir stratégie de tags dans le README)
APP_VERSION=1.0.0
# Port d'entrée en mode prod locale (http://localhost:8080)
HTTP_PORT=8080
DB_USER=postgres
DB_NAME=evaluation